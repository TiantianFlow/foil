{
  "steps": [
    {
      "when": {
        "mail_contains": "Which format"
      },
      "do": [
        {
          "sh": "basename \"$FAKE_MAIL\" >> \"$FAKE_BOARD/notes/$FOIL_SEAT_ID-woken.txt\""
        },
        {
          "sh": "foil post --re \"$FAKE_MAIL\" 'results use json'"
        }
      ]
    },
    {
      "when": {
        "mail_contains": "Settled: json"
      },
      "do": [
        {
          "sh": "basename \"$FAKE_MAIL\" >> \"$FAKE_BOARD/notes/$FOIL_SEAT_ID-woken.txt\""
        },
        {
          "sh": "foil post --re \"$FAKE_MAIL\" 'one more thing'; echo $? > \"$FAKE_BOARD/notes/late.txt\""
        }
      ]
    }
  ]
}
