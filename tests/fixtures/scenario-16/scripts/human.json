{
  "steps": [
    {"run": ["foil", "seat", "join", "lead", "--harness", "codex", "--session", "thread-1"], "capture": {"board": "Board: (\\S+)\\. "}},
    {"run": ["sh", "-c", "printf '%s\\n' '---' 'contract: status/v1' 'state: working' 'updated: 2026-11-11T00:00:00Z' 'questions: []' '---' '' 'One task: make the tests pass.' > {board}/status.md"]},
    {"run": ["foil", "seat", "spawn", "implementer"]},
    {"start": "wait", "run": ["foil", "mail", "wait", "--wake", "--timeout", "60"]},
    {"run": ["foil", "send", "implementer-1", "fix the failing test"]},
    {"await": "wait"},
    {"run": ["foil", "seat", "list"]},
    {"run": ["foil", "mail", "wait", "--timeout", "0"]},
    {"run": ["foil", "mail", "wait", "--timeout", "0"]},
    {"run": ["foil", "seat", "spawn", "reviewer", "--task", "review foil/implementer-1"]},
    {"start": "wait", "run": ["foil", "mail", "wait", "--wake", "--timeout", "60"]},
    {"await": "wait", "capture": {"verdict": " reviewer-1 (\\S+)"}},
    {"run": ["foil", "mail", "read", "{verdict}"]},
    {"when": "approved", "do": [
      {"run": ["git", "merge", "--no-edit", "-m", "merge the fix", "foil/implementer-1"]}
    ]},
    {"run": ["foil", "mail", "wait", "--timeout", "0"]},
    {"run": ["sh", "-c", "mkdir -p {board}/handoffs && printf '%s\\n' 'foil/implementer-1 is merged and reviewed.' > {board}/handoffs/lead.md"]},
    {"run": ["foil", "seat", "leave"]},
    {"run": ["foil", "seat", "spawn", "lead", "--task", "Read board/handoffs/lead.md, then continue the goal."]},
    {"start": "wait", "run": ["foil", "mail", "wait", "--timeout", "60"]},
    {"await": "wait", "capture": {"word": " lead (\\S+)"}},
    {"run": ["foil", "mail", "read", "{word}"]},
    {"run": ["foil", "seat", "list"]}
  ]
}
