{
  "steps": [
    {"run": ["foil", "seat", "spawn", "lead", "--task", "pick a color"]},
    {"start": "wait", "run": ["sh", "-c", "until foil mail list | grep -q ' lead '; do sleep 0.2; done"]},
    {"await": "wait"},
    {"run": ["foil", "mail", "list"], "capture": {"question": " lead (\\S+)"}},
    {"run": ["foil", "mail", "read", "{question}"]},
    {"run": ["foil", "board", "read", "status.md"]},
    {"run": ["foil", "send", "lead", "use blue"]},
    {"start": "wait", "run": ["sh", "-c", "until foil mail list | grep -v '{question}' | grep -q ' lead '; do sleep 0.2; done"]},
    {"await": "wait"},
    {"run": ["sh", "-c", "foil mail list | grep -v '{question}'"], "capture": {"answer": " lead (\\S+)"}},
    {"run": ["foil", "mail", "read", "{answer}"]},
    {"run": ["foil", "board", "read", "status.md"]},
    {"run": ["foil", "seat", "peek", "lead"]}
  ]
}
