{
  "steps": [
    {
      "when": {"mail_contains": "staff one worker"},
      "do": [
        {"sh": "foil seat spawn implementer --task 'report in'"}
      ]
    },
    {
      "when": {"mail_contains": "reporting in"},
      "do": [
        {"write": "board/status.md", "text": "---\ncontract: status/v1\nstate: done\nupdated: 2026-11-10T00:00:00Z\nquestions: []\n---\n\nThe worker reported in.\n"}
      ]
    },
    {
      "when": {"mail_contains": "still there"},
      "do": [
        {"sh": "echo \"$FAKE_LAUNCH\" > \"$FAKE_BOARD/notes/$FOIL_SEAT_ID-after.txt\""}
      ]
    }
  ]
}
